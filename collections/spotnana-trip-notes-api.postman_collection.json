          "name": "Read all agent notes for a trip",
          "request": {
            "name": "Read all agent notes for a trip",
            "description": {
              "content": "Retrieves all agent notes associated with a specific trip. \nEach note in the response includes the message, the sender's basic information, \nand timestamps.\n\nUse this endpoint to:\n- Review the full history of agent notes added to a trip.\n- Identify who created each note and when, using the `senderInfo`, `createdAt`, and `updatedAt` fields.\n\n**Note:** The response may contain a `pnrId` if it was added during the note creation. Otherwise, the `pnrId` field is omitted in the response.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "trips",
