        {
          "id": "3a48a452-b4d5-4e22-a70a-5acf0b8230e4",
          "name": "Delete an agent note",
          "request": {
            "name": "Delete an agent note",
            "description": {
              "content": "Deletes an existing agent note from a trip. \nOnce deleted, the note cannot be retrieved later.\n\nUse this endpoint to:\n- Remove an agent note that is no longer relevant or was added by mistake.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
