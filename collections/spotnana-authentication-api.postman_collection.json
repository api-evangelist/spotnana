          "id": "2bafccb4-8d4f-41fe-aa6f-56fc86e78162",
          "name": "Get oauth2 token",
          "request": {
            "name": "Get oauth2 token",
            "description": {
              "content": "Get oauth2 token using the client credentials.\n{% admonition type=\"warning\" %}\n**Note:** API calls to the `/v2/auth/oauth2-token` and `/get-auth-token` (legacy) endpoints are rate limited.\nWe recommend reusing the existing tokens until they expire.\n{% /admonition %}\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "auth",
                "oauth2-token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) Supported values are `client_credentials` and `urn:ietf:params:oauth:grant-type:token-exchange`."
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) Identifier for the API user."
                },
                {
                  "disabled": false,
                  "key": "client_secret",
                  "value": "<string>",
                  "description": "(Required) Password"
                },
                {
                  "disabled": false,
                  "key": "audience",
                  "value": "<string>",
                  "description": "Identifies the API being accessed in Spotnana."
                },
                {
                  "disabled": false,
                  "key": "subject_token",
                  "value": "<string>",
                  "description": "A security token that represents the identity of the entity on whose behalf the request \nis being made.\n"
                },
                {
                  "disabled": false,
                  "key": "subject_token_type",
                  "value": "<string>",
                  "description": "Indicates the type of the `subject_token` used for token exchange. \nThis field supports the valid types as per the OAUTH 2.0 security framework.\n"
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "The list of space-delimited, case-sensitive strings, as defined in Section 3.3 of \nRFC6749 OAuth 2.0 framework, that allow the client to specify the desired scope of the requested security \ntoken in the context of the service or resource where the token will be used.\n"
                }
              ]
            }
          },
