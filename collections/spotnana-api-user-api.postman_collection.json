        {
          "id": "5b747333-1ada-4080-a6de-d9d4a6eaf76c",
          "name": "Get API users for a TMC",
          "request": {
            "name": "Get API users for a TMC",
            "description": {
              "content": "Retrieves the list of all active API users associated with the caller's TMC.\n\n**Use this endpoint to:**\n- Audit existing API users and their `clientIds` under a TMC.\n- Look up the `clientId` for a specific API user before rotating its client secret or revoking access.\n\n**Notes:**\n- This endpoint supports pagination using `limit` and `offset` query parameters.\n- The response includes only the `clientId` for each user. The `clientSecret` is never returned.\n- Returns only the API users belonging to the caller's contracting TMC.\n- Only a TMC admin can use this endpoint.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "api-users"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Number of results to return"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Offset for pagination"
                }
              ],
              "variable": []
            },
