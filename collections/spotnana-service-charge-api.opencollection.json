{
  "opencollection": "1.0.0",
  "info": {
    "name": "Air Service Charge API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Service Charge",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List service charges",
            "type": "http"
          },
          "http": {
            "method": "POST",
