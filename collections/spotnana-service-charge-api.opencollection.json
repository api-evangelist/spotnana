            "params": [
              {
                "name": "entityType",
                "value": "",
                "type": "path",
                "description": "Entity type for service charge"
              },
              {
                "name": "entityId",
                "value": "",
                "type": "path",
                "description": "Entity ID for service charge e.g. trip ID for entityType = TRIP"
              },
              {
                "name": "type",
                "value": "",
                "type": "path",
                "description": "Service charge type."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "List service charges for a given entity"
        }
      ]
    }
  ],
  "bundled": true
}