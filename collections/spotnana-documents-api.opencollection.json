          "docs": "Upload a document for a specific entity type (e.g., a PNR)."
        },
        {
          "info": {
            "name": "Get document",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-ext-sboxmeta.partners.spotnana.com/v2/documents/:documentId",
            "params": [
              {
                "name": "documentId",
                "value": "f49d00fe-1eda-4304-ba79-a980f565281d",
