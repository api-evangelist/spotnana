              {
                "name": "entityId",
                "value": "123124",
                "type": "query",
                "description": "Entity Id for the given entity type."
              }
            ]
          },
          "docs": "List all the uploaded documents for a specific entity ID and type."
        },
        {
          "info": {
            "name": "Upload a document",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-ext-sboxmeta.partners.spotnana.com/v2/documents",
            "body": {
              "type": "multipart-form",
              "data": []
            }
